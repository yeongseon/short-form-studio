POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=short_form_studio
POSTGRES_USER=short_form_user
POSTGRES_PASSWORD=short_form_password
DATABASE_URL=postgresql://short_form_user:short_form_password@postgres:5432/short_form_studio

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5174

ARTIFACT_ROOT=./data/artifacts

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=qwen3:4b

STABLE_DIFFUSION_BASE_URL=http://stable-diffusion:7860
STABLE_DIFFUSION_DEFAULT_MODEL=sd15

TTS_QWEN3_BASE_URL=http://tts-qwen3:8100
TTS_DEFAULT_VOICE=default
TTS_DEFAULT_LANGUAGE=ko

STT_WHISPER_BASE_URL=http://stt-whisper:8200
STT_DEFAULT_MODEL=whisper-small

# --- External API Provider Keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
STABILITY_API_KEY=
ELEVENLABS_API_KEY=

GPU_LOCK_KEY=gpu:lock
GPU_LOCK_TIMEOUT_SECONDS=600

# --- Authentication ---
# Set to enable API key authentication. Leave empty for open access (local dev).
# When set, only requests with a matching X-API-Key or Authorization: Bearer header
# are allowed. The frontend uses the Vite dev-server proxy, so the browser never
# holds this secret. In production, inject the key via a reverse-proxy header.
API_KEY=
