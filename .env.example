# --- Environment ---
# Set to 'production' to enable startup safety checks.
# In production: API_KEY, CORS_ORIGINS, DATABASE_URL are required; default
# passwords are rejected. Leave as 'development' for local dev.
ENVIRONMENT=development

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=short_form_studio
POSTGRES_USER=short_form_user
POSTGRES_PASSWORD=change-me-before-use
DATABASE_URL=postgresql://short_form_user:change-me-before-use@postgres:5432/short_form_studio

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5174

ARTIFACT_ROOT=./data/artifacts

# Object Storage
STORAGE_BACKEND=local           # 'local', 's3', or 'azure_blob'
# AWS_S3_BUCKET=my-artifacts
# AWS_S3_REGION=us-east-1
# AWS_S3_PREFIX=
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=artifacts

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=qwen3:4b

STABLE_DIFFUSION_BASE_URL=http://stable-diffusion:7860
STABLE_DIFFUSION_DEFAULT_MODEL=sd15

TTS_QWEN3_BASE_URL=http://tts-qwen3:8100
TTS_DEFAULT_VOICE=default
TTS_DEFAULT_LANGUAGE=ko

STT_WHISPER_BASE_URL=http://stt-whisper:8200
STT_DEFAULT_MODEL=whisper-small

# --- External API Provider Keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
STABILITY_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=

GPU_LOCK_KEY=gpu:lock
GPU_LOCK_TIMEOUT_SECONDS=600

# --- Authentication ---
# Local development:
#   1. Run: docker compose run --rm api python scripts/create_api_key.py \
#        --email local@example.com --workspace local --name local-dev
#   2. Copy the generated key and set API_KEY below.
# The API validates keys via SHA-256 hash lookup in the api_keys table.
# The value below is a PLACEHOLDER; it will NOT work until you run create_api_key.py
# and replace it with the actual generated key.
API_KEY=<replace-with-generated-key>

# --- Admin ---
ADMIN_API_KEY=

# --- OpenTelemetry ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=short-form-studio
OTEL_ENVIRONMENT=development
