# ==============================================================================
# Short Form Studio — Environment Configuration
# ==============================================================================
# Variables are marked:
#   REQUIRED  — must be set for the application to start
#   OPTIONAL  — has a sensible default; override only if needed
#   CONDITIONAL — required only when a specific feature/backend is enabled
# ==============================================================================

# --- Environment Mode ---
# OPTIONAL: 'development' (default) or 'production'.
# Production mode enables startup safety checks (rejects default passwords,
# enforces API_KEY and CORS_ORIGINS).
ENVIRONMENT=development

# --- Database ---
# REQUIRED: PostgreSQL connection details.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=short_form_studio
POSTGRES_USER=short_form_user
POSTGRES_PASSWORD=change-me-before-use
DATABASE_URL=postgresql://short_form_user:change-me-before-use@postgres:5432/short_form_studio

# OPTIONAL: DB connection pool size (asyncpg). Tune for production workloads.
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=10

# --- Redis ---
# REQUIRED: Redis connection for Celery task queue.
# Unset REDIS_URL to run in lightweight (synchronous) mode without Celery.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# --- API Server ---
# OPTIONAL: Bind address and port for the FastAPI server.
API_HOST=0.0.0.0
API_PORT=8000
# REQUIRED in production: Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5174

# --- Artifact Storage ---
# OPTIONAL: Path for generated artifacts (videos, images, audio).
ARTIFACT_ROOT=./data/artifacts

# OPTIONAL: Artifact retention window in days. Artifacts older than this
# are marked for deletion by the sweep_expired_artifacts beat task
# (runs every 10 minutes) and then removed from storage by the
# retry_failed_artifact_deletions task. Values <= 0 fall back to the
# default of 90 days; set expires_at = NULL explicitly on a row to
# exempt it from expiry.
# Default: 90
# ARTIFACT_RETENTION_DAYS=90

# OPTIONAL: Object storage backend. Default 'local' stores on filesystem.
STORAGE_BACKEND=local           # 'local', 's3', or 'azure_blob'
# CONDITIONAL: Required when STORAGE_BACKEND=s3
# AWS_S3_BUCKET=my-artifacts
# AWS_S3_REGION=us-east-1
# AWS_S3_PREFIX=
# CONDITIONAL: Required when STORAGE_BACKEND=azure_blob
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=artifacts

# --- Local AI Services (GPU profile) ---
# OPTIONAL: Base URLs for self-hosted AI services. Only needed with `--profile gpu`.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=qwen3:4b

STABLE_DIFFUSION_BASE_URL=http://stable-diffusion:7860
STABLE_DIFFUSION_DEFAULT_MODEL=sd15

TTS_QWEN3_BASE_URL=http://tts-qwen3:8100
TTS_DEFAULT_VOICE=default
TTS_DEFAULT_LANGUAGE=ko

STT_WHISPER_BASE_URL=http://stt-whisper:8200
STT_DEFAULT_MODEL=whisper-small

# --- External API Provider Keys ---
# CONDITIONAL: Set at least one LLM provider key if not using local Ollama.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# CONDITIONAL: Set if using remote image generation.
STABILITY_API_KEY=
# CONDITIONAL: Set if using remote TTS.
ELEVENLABS_API_KEY=
# OPTIONAL: Groq API for fast inference (alternative LLM provider).
GROQ_API_KEY=

# --- GPU Lock ---
# OPTIONAL: Coordination key and timeout for GPU resource locking.
GPU_LOCK_KEY=gpu:lock
GPU_LOCK_TIMEOUT_SECONDS=600

# --- Authentication ---
# REQUIRED: DB-backed API key for creator endpoints.
# Generate via: docker compose run --rm api python scripts/create_api_key.py \
#   --email local@example.com --workspace local --name local-dev
# The API validates keys via SHA-256 hash lookup in the api_keys table.
# The value below is a PLACEHOLDER; it will NOT work until you run create_api_key.py.
API_KEY=<replace-with-generated-key>

# --- Admin ---
# OPTIONAL: Admin API key for /api/admin/* endpoints. Leave empty to disable admin access.
ADMIN_API_KEY=

# --- OpenTelemetry ---
# OPTIONAL: Enable distributed tracing and structured logging.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=short-form-studio
OTEL_ENVIRONMENT=development
