# ===================================================================
# Local Server Environment Configuration
# ===================================================================
# Copy this file to .env before running:
#   cp .env.local.example .env
#
# Then run:
#   make docker-local-up
#   make docker-local-migrate
#   make docker-local-bootstrap
# ===================================================================

# --- Core ---
ENVIRONMENT=development

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=short_form_studio
POSTGRES_USER=short_form_user
POSTGRES_PASSWORD=change-me-before-use
DATABASE_URL=postgresql://short_form_user:change-me-before-use@postgres:5432/short_form_studio

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# If accessing the API directly from another device on the LAN,
# add your local server origin as well, for example:
# CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://192.168.0.10:5174
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# --- Studio Web (LAN access) ---
STUDIO_WEB_BIND=0.0.0.0
STUDIO_WEB_PORT=5174

# --- Artifacts ---
ARTIFACT_ROOT=./data/artifacts
STORAGE_BACKEND=local

# --- AI Provider Keys (fill in as needed) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
STABILITY_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=

# --- Authentication ---
# Run `make docker-local-bootstrap` to generate an API key,
# then paste it here and restart.
API_KEY=<replace-with-generated-key>
ADMIN_API_KEY=local-admin-key-change-me

# --- Telemetry (disabled by default for local) ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=short-form-studio
OTEL_ENVIRONMENT=development

# --- Default Model Configuration ---
# These control API default values when no model is specified in requests.
# edge-tts is recommended for local mode: no GPU, no API key required.
SCRIPT_DEFAULT_MODEL=qwen3-4b
TTS_DEFAULT_MODEL=edge-tts
SUBTITLE_DEFAULT_MODEL=whisper-small
RENDER_DEFAULT_PROFILE=shorts_default
# For Groq cloud LLM (fast, free tier available):
# SCRIPT_DEFAULT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
